FROM golang:1.25.6-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/quick-admin-api ./application/api

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S quickadmin \
    && adduser -S -G quickadmin quickadmin
WORKDIR /app
COPY --from=builder /out/quick-admin-api /app/quick-admin-api
COPY application/api/conf.example.yaml /app/conf.prod.yaml
COPY application/api/zaplogger.example.yaml /app/zaplogger.prod.yaml
RUN chown -R quickadmin:quickadmin /app
USER quickadmin
EXPOSE 9009
ENTRYPOINT ["/app/quick-admin-api"]
