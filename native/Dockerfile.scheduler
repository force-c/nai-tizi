FROM golang:1.26.5-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/quick-admin-scheduler ./application/scheduler

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S quickadmin \
    && adduser -S -G quickadmin quickadmin
WORKDIR /app
COPY --from=builder /out/quick-admin-scheduler /app/quick-admin-scheduler
COPY application/scheduler/conf.example.yaml /app/conf.prod.yaml
COPY application/scheduler/zaplogger.example.yaml /app/zaplogger.prod.yaml
RUN chown -R quickadmin:quickadmin /app
USER quickadmin
ENTRYPOINT ["/app/quick-admin-scheduler"]
